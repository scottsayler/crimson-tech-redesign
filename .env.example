# Crimson Technology — environment variables
# Copy to `.env.local` for local development. Set in Vercel for production.

# -----------------------------------------------------------------------------
# Contact form — email via Resend (optional if Google Sheets webhook is set)
# -----------------------------------------------------------------------------
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend (e.g. "Crimson Technology <hello@yourdomain.com>")
CONTACT_FROM_EMAIL=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=

# -----------------------------------------------------------------------------
# Contact form — Google Sheets capture (optional)
# -----------------------------------------------------------------------------
# Apps Script web app URL that accepts POST JSON and appends a contact row.
# If set, contact submissions are POSTed here in addition to Resend email.
GOOGLE_SHEETS_WEBHOOK_URL=

# Shared secret for Banking CX Friction Assessment webhook (must match Apps Script).
# Required when GOOGLE_SHEETS_WEBHOOK_URL is set for full assessment submissions.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Generic assessment completions — Google Sheets capture (optional)
# -----------------------------------------------------------------------------
# Lightweight webhook for other Decision Center assessments (e.g. network assessment).
# If unset, those assessments still work client-side; results are not persisted server-side.
ASSESSMENT_RESULTS_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Analytics (public client IDs — not secrets)
# Loaded only when NODE_ENV=production. Overrides optional; defaults ship in code.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-P6YQVPG270
NEXT_PUBLIC_CLARITY_PROJECT_ID=xfsmqkx7l7
